{
  "title": "Platform overview",
  "uid": "platform-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "Node CPU utilization", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 2, "title": "Node memory available", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "node_memory_MemAvailable_bytes", "legendFormat": "{{instance}}" }]
    },
    {
      "id": 3, "title": "Pod restarts (15m)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[15m]))", "legendFormat": "{{namespace}}/{{pod}}" }]
    },
    {
      "id": 4, "title": "Database and broker exporters", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "up{service=~\".*(postgres-exporter|redis-exporter|clickhouse|kafka-exporter).*\"}", "legendFormat": "{{service}}" }]
    },
    {
      "id": 5, "title": "Kafka consumer lag", "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [{ "expr": "max by (consumergroup, topic) (kafka_consumergroup_lag)", "legendFormat": "{{consumergroup}} / {{topic}}" }]
    },
    {
      "id": 6, "title": "PostgreSQL transactions per second", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [{ "expr": "sum by (datname) (rate(pg_stat_database_xact_commit[5m]))", "legendFormat": "{{datname}}" }]
    },
    {
      "id": 7, "title": "Redis memory and clients", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        { "expr": "redis_memory_used_bytes", "legendFormat": "memory used" },
        { "expr": "redis_connected_clients", "legendFormat": "connected clients" }
      ]
    },
    {
      "id": 8, "title": "ClickHouse running queries", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [{ "expr": "ClickHouseMetrics_Query", "legendFormat": "queries" }]
    },
    {
      "id": 9, "title": "Kafka brokers", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [{ "expr": "kafka_brokers", "legendFormat": "brokers" }]
    }
  ]
}
