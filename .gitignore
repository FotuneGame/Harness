# Terraform
terraform/.terraform/
terraform/.terraform.lock.hcl
*.tfstate
*.tfstate.*
terraform/*.tfplan
terraform/terraform.tfvars
terraform/crash*.log

# Зависимости Helm скачиваются в charts/. Исключение — Vault и Vault Secrets
# Operator: репозиторий helm.releases.hashicorp.com недоступен.
k8s/*/charts/*
!k8s/secret/charts/*.tgz

# Данные сервисов, ключи и сертификаты. В Git — только .gitkeep двух первых
# уровней: глубже Git не заходит (данные баз большие, в них есть ссылки Linux).
volumes/*
!volumes/*/
volumes/*/*
!volumes/*/.gitkeep
!volumes/*/*/
volumes/*/*/*
!volumes/*/*/.gitkeep

**/__pycache__/
